# Development environment variables
# NOTE: This file is mounted into the container at /app/.env by docker-compose.yml
# Update values and the backend will auto-reload.

# Required
ANTHROPIC_API_KEY=replace-with-your-dev-key

# Virtual display
DISPLAY_NUM=1
WIDTH=1440
HEIGHT=900

# Timezone
TZ=UTC

# Optional app settings
LOG_LEVEL=debug
