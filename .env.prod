# Production environment variables
# NOTE: This file is NOT mounted by default. Provide these via your orchestrator or shell env.
# You can also run: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# Required
ANTHROPIC_API_KEY=replace-with-your-prod-key

# Virtual display
DISPLAY_NUM=1
WIDTH=1440
HEIGHT=900

# Timezone
TZ=UTC

# Optional app settings
# LOG_LEVEL=info
